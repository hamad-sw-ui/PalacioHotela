# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Set these before deploying. The admin account is created on first startup.
ADMIN_EMAIL=admin@palaciohotel.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-a-long-random-secret

# Google sign-in (optional). Leave empty to keep e-mail and password only.
# Admin → Intégrations → Google can store these two values instead; a client ID
# saved there replaces the server variables.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional canonical URI for deployments behind a reverse proxy. Must match Google Cloud exactly.
# GOOGLE_REDIRECT_URI=https://hotel.example.com/api/auth/google/callback

# SMTP (optional until you are ready to send real emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=hamadamin725@gmail.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM="Palacio Hotel <hamadamin725@gmail.com>"

# Optional fallback when Intégrations leaves Stripe empty.
# Stripe Checkout is configured in Admin → Intégrations.
# Stripe charges EUR (XAF is unavailable on most Stripe accounts).
# Official CFA peg 655.957 is used unless STRIPE_XAF_PER_EUR or PAYPAL_XAF_PER_EUR is set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_XAF_PER_EUR=

# Optional fallback when Intégrations leaves PayPal empty.
# PayPal Orders v2 is configured in Admin → Intégrations (EUR at the CFA peg).
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_XAF_PER_EUR=655.957

# Optional fallback when Intégrations leaves the provider on Auto and the API key empty.
# Gemini, OpenAI-compatible providers, and Ollama are configured in Admin → Intégrations.
AI_PROVIDER=auto
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Quote assistant: set to false to hide the optional natural-language helper.
QUOTE_ASSISTANT_ENABLED=true

# Quote PDF v3: set to false to keep creating new quotes with the v2/legacy layouts.
# Existing quotes always keep the version stored with their record.
QUOTE_PDF_V3_ENABLED=true

# Client signatures are required before accepting a new quote.
# Set to false only for a temporary migration fallback.
QUOTE_REQUIRE_CLIENT_SIGNATURE=true
