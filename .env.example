# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Set these before deploying. The admin account is created on first startup.
ADMIN_EMAIL=admin@palaciohotel.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-a-long-random-secret

# SMTP (optional until you are ready to send real emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=bonjour@example.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM="Palacio Hotel <bonjour@example.com>"

# Stripe Checkout (XAF is a zero-decimal currency)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# PayPal Orders v2 (PayPal REST does not support XAF: explicit EUR rate)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=replace-with-paypal-client-id
PAYPAL_CLIENT_SECRET=replace-with-paypal-client-secret
PAYPAL_XAF_PER_EUR=655.957

# Optional AI provider: auto, local, openai or ollama
AI_PROVIDER=auto
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
